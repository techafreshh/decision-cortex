# Decision Cortex — local compose configuration template.
#
#   cp infra/.env.example infra/.env   # then set OPENROUTER_API_KEY
#   docker compose -f infra/docker-compose.yml up -d --build
#
# Compose reads infra/.env as the project .env when the compose file is in
# infra/, so the file lives next to docker-compose.yml, not at the repo root.

# Required for answers. One OpenRouter key powers every System-1/System-2 call.
# Booting, seeding, and /healthz all work with this empty (offline path).
OPENROUTER_API_KEY=

# Hard spend cap (USD) enforced in api/llm.py; the UI ledger surfaces it live.
SPEND_CAP_USD=10

# --- Model slugs (all optional; empty resolves to the documented default) ---
# System-1 typing/classification (router, claim gate, sufficiency stop).
# Default: openai/gpt-4o-mini (the strict-JSON fallback). Decisions-class
# models (TypeSafe Jev, Perplexity pplx-decider) also work via DECIDE_API.
#DECIDE_MODEL_SLUG=openai/gpt-4o-mini
# S1 lane selector: "" = chat/completions schema path, "decisions" = the
# Alpha Decisions endpoint (measured probabilities; ~400 ms; ~$0.0000016/call).
#DECIDE_API=decisions
# System-2 synthesis. Default: openai/gpt-4o-mini.
#REASON_MODEL_SLUG=openai/gpt-4o-mini
# Retrieval embeddings (documents AND queries must share slug+dimension).
# The compile-time defaults (in infra/docker-compose.yml) track the COMMITTED
# artifact: perplexity/pplx-embed-v1-0.6b @ 1024. Changing either means
# regenerating the artifact (python -m ingest.embeddings) or the loader
# refuses the mismatch and the vector index is not built.
#EMBEDDING_MODEL_SLUG=perplexity/pplx-embed-v1-0.6b
#EMBEDDING_DIMENSION=1024
# Build-time stance classification (python -m ingest.stances) override.
# Default: same slug as DECIDE_MODEL_SLUG. Not read inside the api container.
#STANCES_MODEL_SLUG=openai/gpt-4o-mini
# Local faithfulness cross-encoder (Hugging Face id, no API cost).
# Default: vectara/hhallucination_evaluation_model — HHEM-2.1-Open's public
# home (single-h; the double-h id is gated and 401s headless). Requires the
# image's 'faithfulness' extra. Swapping models changes the score polarity
# assumption — re-check docs/faithfulness-notes.md.
#FAITHFULNESS_MODEL_ID=vectara/hallucination_evaluation_model

# Optional. Set to a hostname on a VPS and Caddy provisions automatic HTTPS.
# Leave unset locally: the default `:80` is published on http://localhost:8080.
# SITE_ADDRESS=cortex.example.com
